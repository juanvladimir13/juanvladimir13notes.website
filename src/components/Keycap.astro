---
interface Props {
  text: string;
  size?: "sm" | "md" | "lg";
}

const { text, size = "md" } = Astro.props;

const keySymbols: Record<string, string> = {
  shift: "⇧",
  shiftName: "⇧ Shift",
  ctrl: "Ctrl",
  alt: "Alt",
  altGr: "Alt Gr",
  enter: "↵",
  enterName: "↵ Enter",
  enterNameEs: "↵ Intro",
  backspace: "⌫",
  backspaceName: "⌫ Backspace",
  tab: "⇄ Tab",
  tabName: "Tab",
  bloqMayus: "Bloq Mayús",
  up: "↑",
  down: "↓",
  left: "←",
  right: "→",
  window: "⊞",
  windowName: "⊞ Windows",
  inicioName: "⊞ Inicio",
};

const displayText = keySymbols[text] || text;
---

<kbd class={`keycap size-${size}`}>
  {displayText}
</kbd>

<style>
  /* --- Estilos Base (Modo Claro por defecto) --- */
  .keycap {
    margin: 0px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-weight: 600;
    user-select: none;

    /* Gradiente y colores estilo plástico claro */
    background: linear-gradient(to bottom, #f5f5f5, #e5e5e5);
    color: #262626;

    /* Bordes y relieve 3D */
    border: 1px solid #d4d4d4;
    border-bottom-color: #a3a3a3;

    /* Sombreado: Sombra proyectada + sombra interna para simular volumen */
    box-shadow:
      0 2px 0 rgba(0, 0, 0, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);

    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s;
  }

  /* --- Variaciones de Tamaño --- */
  .size-sm {
    font-size: 0.75rem;
    min-width: 24px;
    height: 24px;
    padding: 0 6px 0px 6px;
    border-radius: 4px;
    border-bottom-width: 3px;
  }

  .size-md {
    font-size: 0.875rem;
    min-width: 36px;
    height: 36px;
    padding: 0 10px 0px 10px;
    border-radius: 6px;
    border-bottom-width: 4px;
  }

  .size-lg {
    font-size: 1rem;
    min-width: 48px;
    height: 48px;
    padding: 0 14px 0px 14px;
    border-radius: 8px;
    border-bottom-width: 6px;
  }

  /* --- Soporte de Modo Oscuro Automático (Media Query del Sistema) --- */
  @media (prefers-color-scheme: dark) {
    .keycap {
      /* Gradiente y colores estilo plástico oscuro */
      background: linear-gradient(to bottom, #262626, #171717);
      color: #e5e5e5;

      /* Bordes oscuros */
      border: 1px solid #404040;
      border-bottom-color: #0a0a0a;

      /* Ajuste de sombras para fondo negro */
      box-shadow:
        0 2px 0 rgba(0, 0, 0, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }
  }
</style>
