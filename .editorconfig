[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
max_line_length = 120

[*.mdx]
trim_trailing_whitespace = false
max_line_length = 120

[*.astro]
trim_trailing_whitespace = false
max_line_length = 120

[*.yml]
trim_trailing_whitespace = false
max_line_length = 120

[*.json]
trim_trailing_whitespace = false
max_line_length = 120
